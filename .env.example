POSTGRES_PASSWORD=your-postgres-password
JWT_KEY=your-jwt-secret-key
# Password for the seeded demo users (testadmin, testuser1, testuser2). Choose your own; demo only.
# Leave empty to skip creating demo users.
DEMO_PASSWORD=your-demo-password

# Optional: where the app is served from, if not on this machine.
# API_URL is baked into the UI at build time; UI_ORIGIN is the browser origin the API allows (CORS).
# API_URL=http://localhost:5186
# UI_ORIGIN=http://localhost:5173
