@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..-RALxKv_unItX9jvhr102WmWREfL7Tv8Mohr4UJmY0I
### Login
POST {{TicketManagement.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
   "username": "{{username}}",
   "password": "{{password}}"
}

### Get all tickets
GET {{TicketManagement.Api_HostAddress}}/api/tickets
Authorization: Bearer {{token}}
Accept: application/json

### Get ticket by ID
GET {{TicketManagement.Api_HostAddress}}/api/tickets/999
Authorization: Bearer {{token}}
Accept: application/json

### Create a ticket
POST {{TicketManagement.Api_HostAddress}}/api/tickets
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "title": "Cannot reset password",
    "description": "User is unable to reset their password.",
    "status": "Open",
    "priority": "High"
}

### Update a ticket
PUT {{TicketManagement.Api_HostAddress}}/api/tickets/12
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "title": "8/27 Updated ticket",
    "description": "8/27 - This ticket was updated",
    "status": "InProgress",
    "priority": "High"
}

### Delete a ticket
DELETE {{TicketManagement.Api_HostAddress}}/api/tickets/43
Authorization: Bearer {{token}}

